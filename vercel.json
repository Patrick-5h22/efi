{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/auth" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/auth" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/auth" },
    { "source": "/consent", "destination": "/consent.html" },
    { "source": "/login", "destination": "/consent.html" }
  ]
}
